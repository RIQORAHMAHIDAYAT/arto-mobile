# URL REST API ARTO backend (tanpa trailing slash).
# - Android emulator: http://10.0.2.2:3000/api
# - Perangkat fisik:   http://<IP-LAN-MESIN>:3000/api (mis. http://192.168.1.5:3000/api)
# - Web (expo web):    http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

